@using TourismMvc.Models.Entities
@model TourismMvc.Models.ViewModels.AdminPaymentViewModel
@{
    ViewData["Title"] = L["Giao dịch thanh toán"];
    string Link(int page) => Url.Action("Index", "Payments", new { search = Model.Search, status = Model.Status, page })!;
}
<header class="page-header"><div class="title-block"><div class="title-icon"><i data-lucide="credit-card"></i></div><div><h1>@L["Giao dịch VNPAY"]</h1><p>@L["Thanh toán Sandbox ·"] @Model.TotalItems @L["giao dịch ·"] @Model.ReviewCount @L["giao dịch cần đối soát"]</p></div></div></header>
@if (Model.ReviewCount > 0) { <p class="payment-admin-warning">@L["Có giao dịch cần đối soát. Kiểm tra mã giao dịch với VNPAY để xác nhận tình trạng thanh toán của khách."]</p> }
<form method="get" class="toolbar"><label class="search-box"><i data-lucide="search"></i><input name="search" value="@Model.Search" aria-label="@L["Tìm giao dịch"]" placeholder="@L["Mã đơn, mã giao dịch hoặc email…"]" /></label><div class="filter-group"><select class="select" name="status" aria-label="@L["Trạng thái giao dịch"]"><option value="">@L["Tất cả trạng thái"]</option>@foreach(var state in Enum.GetValues<VnpayPaymentStatus>()) { <option value="@state" selected="@(Model.Status == state)">@L[new VnpayPayment { Status = state }.StatusLabel]</option> }</select><button class="btn btn-primary" type="submit">@L["Tìm kiếm"]</button><a class="btn btn-ghost" href="/admin/payments">@L["Đặt lại"]</a></div></form>
@if (Model.Items.Count == 0)
{
    <div class="empty"><div class="empty-icon"><i data-lucide="credit-card"></i></div><h3>@L["Chưa có giao dịch phù hợp"]</h3><p>@L["Giao dịch sẽ xuất hiện khi khách bấm thanh toán qua VNPAY."]</p></div>
}
else
{
    <div class="table-card"><div class="table-wrap"><table class="table"><thead><tr><th>@L["Đơn đặt tour / Khách hàng"]</th><th>@L["Giao dịch"]</th><th>@L["Số tiền"]</th><th>@L["Trạng thái"]</th><th>@L["Kiểm tra"]</th></tr></thead><tbody>
    @foreach (var item in Model.Items)
    {
        <tr><td><a href="/admin/bookings/@item.BookingId"><strong>@item.Booking?.BookingCode</strong></a><div class="muted">@item.Booking?.ContactFullName</div><div class="muted">@item.Booking?.ContactEmail</div></td><td><span class="payment-admin-reference">@item.TransactionRef</span><div class="muted">@item.CreatedAt.ToString(L.DateTimeFormat, L.Culture)</div>@if (!string.IsNullOrEmpty(item.ProviderTransactionNo)) { <div>VNPAY: @item.ProviderTransactionNo</div> } @if (!string.IsNullOrEmpty(item.BankCode)) { <div>@item.BankCode</div> }</td><td style="white-space:nowrap">@item.Amount.ToString("N0", L.Culture) ₫</td><td><span class="badge @(item.Status == VnpayPaymentStatus.REVIEW_REQUIRED ? "badge-north" : item.Status == VnpayPaymentStatus.SUCCEEDED ? "badge-south" : "badge-central")">@L[item.StatusLabel]</span>@if (!string.IsNullOrEmpty(item.ResponseCode)) { <div class="muted">@L["Mã:"] @item.ResponseCode / @item.TransactionStatus</div> }</td><td>@if (item.Status is VnpayPaymentStatus.PENDING or VnpayPaymentStatus.EXPIRED) { <form method="post" action="/admin/payments/@item.Id/refresh">@Html.AntiForgeryToken()<button class="btn btn-ghost" type="submit">@L["Kiểm tra"]</button></form> }</td></tr>
    }
    </tbody></table></div><footer class="table-foot"><span class="muted">@L["Trang"] @Model.Page / @Model.TotalPages</span><nav class="pagination" aria-label="@L["Phân trang giao dịch"]">@if(Model.Page > 1) { <a class="page-btn" href="@Link(Model.Page - 1)">@L["Trước"]</a> } @if(Model.Page < Model.TotalPages) { <a class="page-btn" href="@Link(Model.Page + 1)">@L["Sau"]</a> }</nav></footer></div>
}
<style>.payment-admin-warning{padding:16px;border-radius:10px;background:#fff7ed;color:#9a3412;line-height:1.7}.payment-admin-reference{font-family:var(--mono);font-size:11px;overflow-wrap:anywhere}.filter-group{flex-wrap:wrap}.table td{min-width:130px}.crumbs{min-width:0}.crumbs strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}@@media(max-width:600px){.topbar-right>span{display:none}.crumbs{flex:1}.crumbs>span,.crumbs>svg{display:none}}</style>
