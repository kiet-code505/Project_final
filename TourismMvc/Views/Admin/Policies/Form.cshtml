@model PolicyFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? L["Chỉnh sửa Mẫu chính sách"] : L["Thêm Mẫu chính sách mới"];
    ViewData["Description"] = L["Tạo mẫu chính sách và điều khoản áp dụng cho các tour du lịch."];
}

<header class="page-header">
    <div class="title-block">
        <a href="/admin/policies" class="back-btn" title="@L["Quay lại danh sách"]" id="btnBack"><i data-lucide="arrow-left"></i></a>
        <div>
            <h1>@ViewData["Title"]</h1>
            <p>@(Model.IsEdit ? $"ID: {Model.PolicyTemplateID} · {Model.TemplateName}" : L["Điền thông tin và quy định điều khoản tour"])</p>
        </div>
    </div>
</header>

<form method="post" class="card" style="max-width: 920px; margin: 0 auto;"
      action="@(Model.IsEdit ? $"/admin/policies/{Model.PolicyTemplateID}/edit" : "/admin/policies/create")">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    @* ── Section: Thông tin cơ bản ── *@
    <div class="form-section">
        <h3 class="card-title"><i data-lucide="info"></i> @L["Thông tin cơ bản"]</h3>
        
        <div class="form-row">
            <div class="form-group" style="flex: 2;">
                <label asp-for="TemplateName">@L["Tên mẫu chính sách"] <span class="req">*</span></label>
                <input asp-for="TemplateName" placeholder="@L["VD: Chính sách tour tiêu chuẩn 2026, Điều khoản tour VIP…"]" autocomplete="off" autofocus />
                <span asp-validation-for="TemplateName" class="field-error"></span>
            </div>

            <div class="form-group" style="flex: 1.2;">
                <label asp-for="ContactId">@L["Chi nhánh phụ trách"] <span class="req">*</span></label>
                <select asp-for="ContactId" class="select" style="width: 100%;">
                    <option value="">@L["-- Chọn chi nhánh --"]</option>
                    @foreach (var b in Model.AvailableBranches)
                    {
                        <option value="@b.ContactID" selected="@(Model.ContactId == b.ContactID)">@b.BranchName</option>
                    }
                </select>
                <span asp-validation-for="ContactId" class="field-error"></span>
            </div>
        </div>
    </div>

    @* ── Section: Giá tour ── *@
    <div class="form-section" style="margin-top: 24px;">
        <h3 class="card-title"><i data-lucide="badge-dollar-sign"></i> @L["Giá tour bao gồm & không bao gồm"]</h3>

        <div class="form-group">
            <label asp-for="TourPriceIncludes">@L["Giá tour bao gồm"]</label>
            <textarea asp-for="TourPriceIncludes" rows="5" placeholder="@L["Nhập danh sách dịch vụ đã bao gồm trong giá tour (vé máy bay, khách sạn, xe đưa đón, bữa ăn, bảo hiểm...)..."]"></textarea>
            <span class="hint">@L["Hỗ trợ nhập văn bản có xuống dòng hoặc mã HTML cơ bản."]</span>
            <span asp-validation-for="TourPriceIncludes" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="TourPriceExcludes">@L["Giá tour không bao gồm"]</label>
            <textarea asp-for="TourPriceExcludes" rows="4" placeholder="@L["Nhập các chi phí phát sinh khách tự chi trả (chi phí cá nhân, đồ uống, phòng đơn, tiền tip HDV...)..."]"></textarea>
            <span asp-validation-for="TourPriceExcludes" class="field-error"></span>
        </div>
    </div>

    @* ── Section: Thanh toán & Huỷ tour ── *@
    <div class="form-section" style="margin-top: 24px;">
        <h3 class="card-title"><i data-lucide="scale"></i> @L["Điều kiện thanh toán & Quy định huỷ tour"]</h3>

        <div class="form-group">
            <label asp-for="PaymentConditions">@L["Điều kiện thanh toán"]</label>
            <textarea asp-for="PaymentConditions" rows="5" placeholder="@L["Quy định đặt cọc và thanh toán số tiền còn lại trước ngày khởi hành..."]"></textarea>
            <span asp-validation-for="PaymentConditions" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="CancellationRules">@L["Quy định huỷ tour"]</label>
            <textarea asp-for="CancellationRules" rows="5" placeholder="@L["Quy định mức phạt khi huỷ tour theo số ngày trước chuyến đi (sau khi đăng ký, trước 15 ngày, 7 ngày...)..."]"></textarea>
            <span asp-validation-for="CancellationRules" class="field-error"></span>
        </div>
    </div>

    <div class="form-actions" style="margin-top: 24px; border-top: 1px solid var(--border); padding-top: 16px;">
        <a href="/admin/policies" class="btn btn-ghost">@L["Huỷ"]</a>
        <button type="submit" class="btn btn-primary">
            <i data-lucide="check-circle-2"></i> @(Model.IsEdit ? L["Cập nhật mẫu chính sách"] : L["Tạo mẫu chính sách"])
        </button>
    </div>
</form>
