@model DepartureCloneViewModel
@{ ViewData["Title"] = "Sao chép lịch khởi hành"; }
<link rel="stylesheet" href="~/css/admin-departures.css" asp-append-version="true" />
<header class="page-header"><div class="title-block"><a class="back-btn" href="@(Model.ReturnUrl ?? "/admin/departures")" aria-label="Quay lại"><i data-lucide="arrow-left"></i></a><div><h1>Sao chép lịch khởi hành</h1><p>@Model.TourName</p></div></div></header>
<form method="post" action="/admin/departures/@Model.Id/clone" class="card departure-clone-form">
    @Html.AntiForgeryToken()<input asp-for="ReturnUrl" type="hidden" />
    <div asp-validation-summary="All" class="departure-validation" role="alert"></div>
    <p>Lịch gốc: <strong>#@Model.Id · @Model.OriginalDate.ToString("dd/MM/yyyy HH:mm")</strong></p>
    <p class="hint">Sao chép hướng dẫn viên, chính sách, bảng giá và vận chuyển. Giờ đi/đến dịch theo ngày mới. Lịch mới hoạt động và không có booking.</p>
    <div class="form-group"><label asp-for="NewDepartureDate">Ngày giờ khởi hành mới <span class="req">*</span></label><input asp-for="NewDepartureDate" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" step="1" required /><span asp-validation-for="NewDepartureDate" class="field-error"></span></div>
    <div class="form-group"><label asp-for="AvailableSlots">Số chỗ mở bán <span class="req">*</span></label><input asp-for="AvailableSlots" type="number" min="1" step="1" required /><span class="hint">Gợi ý bằng chỗ trống cộng chỗ đang đặt của lịch gốc. Bạn có thể điều chỉnh.</span><span asp-validation-for="AvailableSlots" class="field-error"></span></div>
    <div class="departure-form-actions"><a class="btn btn-ghost" href="@(Model.ReturnUrl ?? "/admin/departures")">Hủy</a><button class="btn btn-primary" type="submit"><i data-lucide="copy"></i> Sao chép</button></div>
</form>
