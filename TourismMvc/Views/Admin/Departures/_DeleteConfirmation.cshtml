<dialog class="departure-delete-dialog" id="departure-delete-dialog" aria-labelledby="departure-delete-title">
    <form method="dialog">
        <h2 id="departure-delete-title">Xóa lịch khởi hành?</h2>
        <p data-delete-description></p>
        <p class="hint">Lịch đã có booking sẽ được giữ lại. Nếu một lịch trong nhóm không thể xóa, cả nhóm sẽ được giữ nguyên.</p>
        <div class="departure-form-actions"><button class="btn btn-ghost" value="cancel">Hủy</button><button class="btn btn-danger" value="confirm">Xác nhận xóa</button></div>
    </form>
</dialog>
