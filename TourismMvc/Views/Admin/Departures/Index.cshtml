@model DepartureIndexViewModel
@{
    ViewData["Title"] = L["Quản lý lịch khởi hành"];
    var vi = L.Culture;
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    string Link(int page) => "/admin/departures" + Microsoft.AspNetCore.Http.QueryString.Create(
        new Dictionary<string, string?> {
            ["search"] = Model.Search, ["tourId"] = Model.TourId?.ToString(),
            ["startDate"] = Model.StartDate?.ToString("yyyy-MM-dd"),
            ["endDate"] = Model.EndDate?.ToString("yyyy-MM-dd"),
            ["status"] = Model.Status?.ToString().ToLowerInvariant(),
            ["newestFirst"] = Model.NewestFirst.ToString(),
            ["pageSize"] = Model.PageSize.ToString(), ["page"] = page.ToString()
        }.Where(x => !string.IsNullOrEmpty(x.Value)));
}
<link rel="stylesheet" href="~/css/admin-departures.css" asp-append-version="true" />
<header class="page-header">
    <div class="title-block">
        <div class="title-icon"><i data-lucide="calendar-days"></i></div>
        <div><h1>@L["Quản lý lịch khởi hành"]</h1><p>@L["Lịch theo tour, tình trạng chỗ, giá và vận chuyển"]</p></div>
    </div>
</header>
<div class="departure-tools">
    <a class="btn btn-primary" href="@Url.Action("Create", "Departures", new { tourId = Model.TourId, returnUrl = currentUrl })"><i data-lucide="plus"></i> @L["Thêm lịch khởi hành"]</a>
    <a class="btn btn-ghost" href="@("/admin/departures/export" + Link(Model.Page).Substring("/admin/departures".Length))"><i data-lucide="download"></i> @L["Xuất CSV trang này"]</a>
    <button class="btn btn-ghost" type="button" data-expand-departures="true">@L["Mở rộng tất cả"]</button>
    <button class="btn btn-ghost" type="button" data-expand-departures="false">@L["Thu gọn tất cả"]</button>
</div>
<section class="stats-grid">
    <div class="stat-card"><div class="stat-icon stat-blue"><i data-lucide="calendar-days"></i></div><div><div class="stat-label">@L["Tổng lịch theo bộ lọc"]</div><div class="stat-value">@Model.TotalItems</div></div></div>
    <div class="stat-card"><div class="stat-icon stat-green"><i data-lucide="check-circle-2"></i></div><div><div class="stat-label">@L["Đang hoạt động"]</div><div class="stat-value">@Model.ActiveCount</div></div></div>
    <div class="stat-card"><div class="stat-icon stat-amber"><i data-lucide="armchair"></i></div><div><div class="stat-label">@L["Chỗ còn trống"]</div><div class="stat-value">@Model.AvailableSlots</div></div></div>
    <div class="stat-card"><div class="stat-icon stat-rose"><i data-lucide="users"></i></div><div><div class="stat-label">@L["Hành khách đã đặt"]</div><div class="stat-value">@Model.BookedSlots</div></div></div>
</section>
<form class="toolbar departure-filters" method="get" action="/admin/departures">
    @if (Model.TourId.HasValue) { <input type="hidden" name="tourId" value="@Model.TourId" /> }
    <label class="search-box"><i data-lucide="search"></i><input type="search" name="search" value="@Model.Search" placeholder="@L["Tìm mã tour hoặc tên tour…"]" aria-label="@L["Tìm tour"]" /></label>
    <label>@L["Từ ngày"]<input class="select" type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" /></label>
    <label>@L["Đến ngày"]<input class="select" type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" /></label>
    <label>@L["Chọn nhanh"]<select class="select" data-date-range><option value="">@L["Chọn khoảng ngày"]</option><option value="today">@L["Hôm nay"]</option><option value="week">@L["Tuần này"]</option><option value="month">@L["Tháng này"]</option><option value="next-month">@L["Tháng sau"]</option><option value="all">@L["Tất cả ngày"]</option></select></label>
    <select class="select" name="status" aria-label="@L["Trạng thái"]">
        <option value="">@L["Mọi trạng thái"]</option>
        <option value="true" selected="@(Model.Status == true)">@L["Hoạt động"]</option>
        <option value="false" selected="@(Model.Status == false)">@L["Tạm dừng"]</option>
    </select>
    <select class="select" name="newestFirst" aria-label="@L["Sắp xếp"]">
        <option value="false" selected="@(!Model.NewestFirst)">@L["Ngày khởi hành tăng dần"]</option>
        <option value="true" selected="@Model.NewestFirst">@L["Mới tạo trước"]</option>
    </select>
    <select class="select" name="pageSize" aria-label="@L["Số lịch mỗi trang"]">
        @foreach (var size in new[] { 10, 20, 50 }) { <option value="@size" selected="@(Model.PageSize == size)">@size @L["/ trang"]</option> }
    </select>
    <button class="btn btn-primary" type="submit"><i data-lucide="filter"></i> @L["Lọc"]</button>
    <a class="btn btn-ghost" href="/admin/departures">@L["Xoá bộ lọc"]</a>
</form>
<div asp-validation-summary="All" class="departure-validation"></div>
@if (Model.Items.Count == 0)
{
    <div class="empty"><div class="empty-icon"><i data-lucide="calendar-days"></i></div><h3>@L["Không có lịch khởi hành"]</h3><p>@L["Chưa có dữ liệu hoặc không có lịch phù hợp với bộ lọc."]</p></div>
}
else
{
    <form id="departure-bulk-delete" method="post" action="/admin/departures/delete-selected" class="departure-bulk" data-departure-delete>
        @Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@currentUrl" />
        <label class="departure-check"><input type="checkbox" data-select-departures /> @L["Chọn tất cả trên trang"]</label>
        <span data-selected-count>@L["Đã chọn 0 lịch"]</span>
        <button class="btn btn-danger" type="submit" data-delete-selected disabled><i data-lucide="trash-2"></i> @L["Xóa lịch đã chọn"]</button>
    </form>
    @foreach (var group in Model.Items.GroupBy(d => new { d.TourId, d.TourCode, d.TourName, d.Duration }))
    {
        <details class="table-card departure-group" open>
            <summary class="departure-group-heading">
                <i data-lucide="package"></i>
                <div><strong>@group.Key.TourName</strong><div class="muted">@group.Key.TourCode · @group.Key.Duration</div></div>
                <span class="departure-group-count">@group.Count() @L["lịch trên trang"]</span>
                <i data-lucide="chevron-down" class="accordion-arrow"></i>
            </summary>
            <div class="table-wrap"><table class="table">
                <thead><tr><th>@L["Chọn"]</th><th>@L["Ngày khởi hành"]</th><th>@L["Tình trạng chỗ"]</th><th>@L["Giá người lớn từ"]</th><th>@L["Vận chuyển"]</th><th>@L["Trạng thái"]</th><th>@L["Thao tác"]</th></tr></thead>
                <tbody>
                @foreach (var d in group)
                {
                    var detailUrl = Url.Action("Details", "Departures", new { id = d.DepartureId, returnUrl = currentUrl });
                    <tr>
                        <td><input type="checkbox" name="ids" value="@d.DepartureId" form="departure-bulk-delete" data-departure-id aria-label="@L["Chọn lịch #{0}", d.DepartureId]" /></td>
                        <td><a href="@detailUrl"><strong>@d.DepartureDate.ToString(L.DateFormat, L.Culture)</strong></a><div class="muted">@d.DepartureDate.ToString("HH:mm") · #@d.DepartureId</div></td>
                        <td><strong>@d.AvailableSlots @L["còn"]</strong><div class="muted">@d.BookedSlots @L["đã đặt"]</div>@if (d.AvailableSlots == 0) { <span class="status-pill status-off">@L["Hết chỗ"]</span> }</td>
                        <td>@(d.LowestPrice.HasValue ? d.LowestPrice.Value.ToString("N0", vi) + " ₫" : L["Chưa có giá"])</td>
                        <td><div class="tour-stats">
                            @if (d.HasOutbound) { <span class="tour-stat"><i data-lucide="plane-takeoff"></i>@L["Chiều đi"]</span> }
                            @if (d.HasInbound) { <span class="tour-stat"><i data-lucide="plane-landing"></i>@L["Chiều về"]</span> }
                            @if (!d.HasOutbound && !d.HasInbound) { <span class="muted">@L["Chưa có"]</span> }
                        </div></td>
                        <td><span class="status-pill @(d.Active ? "status-on" : "status-off")">@(d.Active ? L["Hoạt động"] : L["Tạm dừng"])</span></td>
                        <td><div class="departure-row-actions">
                            <a class="icon-btn" href="@detailUrl" title="@L["Xem chi tiết"]"><i data-lucide="eye"></i></a>
                            <a class="icon-btn" href="@Url.Action("Edit", "Departures", new { id = d.DepartureId, returnUrl = currentUrl })" title="@L["Chỉnh sửa"]"><i data-lucide="pencil"></i></a>
                            <a class="icon-btn" href="@Url.Action("Clone", "Departures", new { id = d.DepartureId, returnUrl = currentUrl })" title="@L["Sao chép sang ngày khác"]"><i data-lucide="copy"></i></a>
                            <form method="post" action="/admin/departures/@d.DepartureId/delete" data-departure-delete>
                                @Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@currentUrl" />
                                <button class="icon-btn departure-delete" type="submit" title="@L["Xóa lịch #{0}", d.DepartureId]"><i data-lucide="trash-2"></i></button>
                            </form>
                        </div></td>
                    </tr>
                }
                </tbody>
            </table></div>
        </details>
    }
    <footer class="table-foot">
        <span class="muted">@L["Hiển thị"] @((Model.Page - 1) * Model.PageSize + 1)–@Math.Min(Model.Page * Model.PageSize, Model.TotalItems) @L["trên"] @Model.TotalItems @L["lịch"]</span>
        @if (Model.TotalPages > 1)
        {
            <nav class="pagination" aria-label="@L["Phân trang"]">
                @if (Model.Page > 1) { <a class="page-btn" href="@Link(Model.Page - 1)">@L["Trước"]</a> }
                @for (var p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                { <a class="page-num @(p == Model.Page ? "active" : "")" href="@Link(p)" aria-current="@(p == Model.Page ? "page" : null)">@p</a> }
                @if (Model.Page < Model.TotalPages) { <a class="page-btn" href="@Link(Model.Page + 1)">@L["Sau"]</a> }
            </nav>
        }
    </footer>
}
<partial name="~/Views/Admin/Departures/_DeleteConfirmation.cshtml" />
@section Scripts { <script src="~/js/admin-departures.js" asp-append-version="true"></script> }
