@model TourismMvc.Models.ViewModels.AdminBookingDetailsViewModel
@{
    ViewData["Title"] = L["Chi tiết booking"];
    var b = Model.Booking;
    var departure = b.TourDeparture;
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    string Money(decimal value) => value.ToString("N0", L.Culture) + " ₫";
}
<link rel="stylesheet" href="~/css/admin-bookings.css" asp-append-version="true" />
<header class="page-header"><div class="title-block"><div class="title-icon"><i data-lucide="ticket"></i></div><div><h1>@b.BookingCode</h1><p>@L["Ngày đặt:"] @b.BookingDate.ToString(L.TimeDateFormat, L.Culture)</p></div></div><a class="btn btn-ghost" href="@Model.ReturnUrl"><i data-lucide="arrow-left"></i>@L["Danh sách booking"]</a></header>
<section class="booking-overview"><div><span class="booking-status @b.BookingStatus.CssClass()">@L[b.BookingStatus.Label()]</span>@if (b.PaymentDeadline.HasValue) { <p class="muted">@L["Hạn thanh toán:"] @b.PaymentDeadline.Value.ToString(L.TimeDateFormat, L.Culture)</p> }</div><div class="booking-overview-actions">
    @if (Model.CanConfirm) { <a class="btn btn-primary" id="confirm-booking" href="@Url.Action("Confirm", "Bookings", new { id = b.BookingID, returnUrl = currentUrl })"><i data-lucide="circle-check"></i>@L["Xác nhận đã thu tiền"]</a> }
    @if (Model.CanCancel) { <a class="btn btn-danger" id="cancel-booking" href="@Url.Action("Cancel", "Bookings", new { id = b.BookingID, returnUrl = currentUrl })"><i data-lucide="circle-x"></i>@L["Hủy booking"]</a> }
    @if (b.Payments.Any(p => p.Status is VnpayPaymentStatus.PENDING or VnpayPaymentStatus.EXPIRED)) { <form method="post" action="/admin/bookings/@b.BookingID/refresh-payment">@Html.AntiForgeryToken()<button class="btn btn-ghost" type="submit"><i data-lucide="refresh-cw"></i>@L["Kiểm tra thanh toán"]</button></form> }
</div></section>
@if (b.Payments.Any(p => p.Status == VnpayPaymentStatus.REVIEW_REQUIRED)) { <p class="booking-notice" role="status">@L["Đơn có giao dịch cần đối soát. Vui lòng kiểm tra thông tin tại mục Thanh toán trước khi xử lý tiếp."]</p> }
@if (b.BookingStatus == BookingStatus.PAID) { <p class="booking-notice booking-success">@L["Đơn đã thanh toán. Chức năng hủy chỉ áp dụng cho booking chưa thanh toán."]</p> }
<div class="booking-detail-grid">
    <section class="booking-panel"><h2><i data-lucide="map"></i>@L["Thông tin chuyến đi"]</h2><h3>@departure?.Tour?.TourName</h3><dl class="booking-info"><div><dt>@L["Mã tour"]</dt><dd>@departure?.Tour?.TourCode</dd></div><div><dt>@L["Khởi hành"]</dt><dd>@departure?.DepartureDate.ToString(L.TimeDateFormat, L.Culture)</dd></div><div><dt>@L["Thời lượng"]</dt><dd>@departure?.Tour?.Duration</dd></div><div><dt>@L["Hành trình"]</dt><dd>@departure?.Tour?.StartLocation?.LocationName → @departure?.Tour?.EndLocation?.LocationName</dd></div><div><dt>@L["Hành khách"]</dt><dd>@b.TotalPassengers @L["người"]</dd></div><div><dt>@L["Tổng tiền"]</dt><dd class="booking-total">@Money(b.TotalPrice)</dd></div></dl><a class="booking-inline-link" href="/admin/departures/@b.DepartureId">@L["Xem lịch khởi hành"] <i data-lucide="arrow-up-right"></i></a></section>
    <section class="booking-panel"><h2><i data-lucide="contact"></i>@L["Thông tin liên hệ"]</h2><dl class="booking-info"><div><dt>@L["Họ tên"]</dt><dd>@b.ContactFullName</dd></div><div><dt>@L["Số điện thoại"]</dt><dd>@b.ContactPhone</dd></div><div><dt>Email</dt><dd>@b.ContactEmail</dd></div><div><dt>@L["Địa chỉ"]</dt><dd>@b.ContactAddress</dd></div><div><dt>@L["Người đặt"]</dt><dd>@if (b.UserId.HasValue) { <a class="booking-inline-link" href="/admin/users/@b.UserId">@(Model.AccountName ?? L["Tài khoản #"] + b.UserId)</a><small class="booking-cell-note">@Model.AccountEmail</small> } else { <span>@L["Khách vãng lai"]</span> }</dd></div></dl>@if (!string.IsNullOrWhiteSpace(b.CustomerNote)) { <div class="booking-customer-note"><strong>@L["Ghi chú của khách"]</strong><p>@b.CustomerNote</p></div> }</section>
</div>
<section class="booking-panel"><h2><i data-lucide="users"></i>@L["Danh sách hành khách"] <span class="muted">(@b.Passengers.Count)</span></h2>
@if (b.Passengers.Count == 0) { <p class="muted">@L["Đơn chưa có thông tin hành khách chi tiết."]</p> }
else
{
    <div class="table-wrap"><table class="table booking-passengers"><thead><tr><th>@L["Họ tên"]</th><th>@L["Giới tính"]</th><th>@L["Ngày sinh"]</th><th>@L["Loại vé"]</th><th>@L["Giá vé"]</th></tr></thead><tbody>@foreach(var person in b.Passengers.OrderBy(p => p.BookingPassengerID)) { <tr><td>@person.FullName</td><td>@L[person.Gender ?? ""]</td><td>@person.DateOfBirth.ToString(L.DateFormat, L.Culture)</td><td>@(person.PassengerType switch { "ADULT" => L["Người lớn"], "CHILD" => L["Trẻ em"], "INFANT" => L["Em bé"], _ => person.PassengerType })</td><td class="booking-money">@Money(person.BasePrice)</td></tr> }</tbody></table></div>
}
</section>
@if (departure?.Transports.Count > 0)
{
    <section class="booking-panel"><h2><i data-lucide="bus"></i>@L["Phương tiện di chuyển"]</h2><div class="booking-transports">@foreach(var transport in departure.Transports.OrderBy(t => t.Type)) { <article><strong>@(transport.Type == TransportType.OUTBOUND ? L["Chiều đi"] : L["Chiều về"]) · @(transport.VehicleName ?? departure.Tour?.Transportation)</strong><p>@transport.StartPoint → @transport.EndPoint</p><p class="muted">@transport.DepartTime?.ToString(L.TimeDateFormat, L.Culture) @if (!string.IsNullOrEmpty(transport.TransportCode)) { <span>· @transport.TransportCode</span> }</p></article> }</div></section>
}
<section class="booking-panel"><h2><i data-lucide="credit-card"></i>@L["Lịch sử thanh toán"]</h2>
@if (b.Payments.Count == 0)
{ <p class="muted">@L["Chưa có giao dịch VNPAY cho booking này."]</p> }
else
{
    <div class="table-wrap"><table class="table booking-payment-table"><thead><tr><th>@L["Mã giao dịch"]</th><th>@L["Ngày tạo"]</th><th>@L["Số tiền"]</th><th>@L["Trạng thái"]</th><th>@L["VNPAY / Ngân hàng"]</th></tr></thead><tbody>@foreach (var payment in b.Payments.OrderByDescending(p => p.Id)) { <tr><td class="booking-reference">@payment.TransactionRef</td><td>@payment.CreatedAt.ToString(L.TimeDateFormat, L.Culture)</td><td class="booking-money">@Money(payment.Amount)</td><td><span class="booking-status @(payment.Status == VnpayPaymentStatus.SUCCEEDED ? "booking-paid" : payment.Status == VnpayPaymentStatus.REVIEW_REQUIRED ? "booking-cancelled" : "booking-pending")">@L[payment.StatusLabel]</span></td><td>@(string.IsNullOrEmpty(payment.ProviderTransactionNo) ? "—" : payment.ProviderTransactionNo)<small class="booking-cell-note">@payment.BankCode</small>@if (payment.SettledAt.HasValue) { <small class="booking-cell-note">@payment.SettledAt.Value.ToString(L.TimeDateFormat, L.Culture)</small> }</td></tr> }</tbody></table></div>
}
</section>
