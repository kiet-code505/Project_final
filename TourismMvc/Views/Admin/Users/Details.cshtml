@using TourismMvc.Models.ViewModels
@model AdminUserDetailsViewModel
@{
    ViewData["Title"] = L["Chi tiết người dùng"];
    var account = Model.Account;
    var self = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == account.Id.ToString();
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    string PageLink(int page) => Url.Action("Details", "Users", new { id = account.Id, page, returnUrl = Model.ReturnUrl })!;
}
<link rel="stylesheet" href="~/css/admin-users.css" asp-append-version="true" />
<header class="page-header"><div class="title-block"><div class="title-icon"><i data-lucide="user-round"></i></div><div><h1>@L["Chi tiết người dùng"]</h1><p>@L["Thông tin tài khoản và các đơn đặt tour đã liên kết"]</p></div></div><a class="btn btn-ghost" href="@Model.ReturnUrl"><i data-lucide="arrow-left"></i>@L["Danh sách người dùng"]</a></header>
<section class="user-profile">
    <div class="user-card-heading"><div class="user-avatar"><i data-lucide="user-round"></i></div><div><h2>@account.FullName</h2><p>#@account.Id · @L[account.RoleLabel]</p></div><span class="badge @(account.Status ? "user-active" : "user-locked")">@(account.Status ? L["Đang hoạt động"] : L["Đã khóa"])</span></div>
    <dl class="user-profile-info"><div><dt>Email</dt><dd>@account.Email</dd></div><div><dt>@L["Số điện thoại"]</dt><dd>@(string.IsNullOrEmpty(account.Phone) ? L["Chưa cập nhật"] : account.Phone)</dd></div><div><dt>@L["Xác thực email"]</dt><dd>@(account.IsEmailVerified ? L["Đã xác thực"] : L["Chưa xác thực"])</dd></div><div><dt>@L["Đơn đặt tour"]</dt><dd>@account.BookingCount @L["đơn"]</dd></div></dl>
    @if (!self) { <a class="btn @(account.Status ? "user-lock-btn" : "user-unlock-btn")" href="@Url.Action("Status", "Users", new { id = account.Id, returnUrl = currentUrl })"><i data-lucide="@(account.Status ? "lock-keyhole" : "unlock-keyhole")"></i>@(account.Status ? L["Khóa tài khoản"] : L["Mở khóa tài khoản"])</a> }
</section>
<section class="user-bookings">
    <h2>@L["Lịch sử đặt tour"] <span class="muted">(@account.BookingCount)</span></h2>
    @if (Model.Bookings.Count == 0)
    {
        <div class="empty"><div class="empty-icon"><i data-lucide="ticket"></i></div><h3>@L["Chưa có đơn đặt tour"]</h3><p>@L["Tài khoản này chưa có đơn đặt tour liên kết."]</p></div>
    }
    else
    {
        <div class="table-wrap"><table class="table"><thead><tr><th>@L["Mã đơn / Ngày đặt"]</th><th>@L["Tour / Khởi hành"]</th><th>@L["Hành khách"]</th><th>@L["Tổng tiền"]</th><th>@L["Trạng thái"]</th></tr></thead><tbody>
            @foreach (var booking in Model.Bookings)
            {
                <tr><td><a href="/admin/bookings/@booking.Id"><strong>@booking.BookingCode</strong></a><small class="user-cell-note">@booking.BookingDate.ToString(L.DateTimeFormat, L.Culture)</small></td><td><a class="user-tour-link" href="@Url.Action("Details", "PublicTourDetail", new { tourCode = booking.TourCode })">@booking.TourName</a><small class="user-cell-note">@booking.DepartureDate.ToString(L.DateFormat, L.Culture)</small></td><td>@booking.TotalPassengers @L["người"]</td><td class="user-money">@booking.TotalPrice.ToString("N0", L.Culture) ₫</td><td><span class="user-booking-status">@L[booking.StatusLabel]</span></td></tr>
            }
        </tbody></table></div>
        <footer class="table-foot user-pagination"><span class="muted">@L["Trang"] @Model.Page / @Model.TotalPages</span><nav class="pagination" aria-label="@L["Phân trang lịch sử đặt tour"]">@if (Model.Page > 1) { <a class="page-btn" href="@PageLink(Model.Page - 1)">@L["Trước"]</a> } @if (Model.Page < Model.TotalPages) { <a class="page-btn" href="@PageLink(Model.Page + 1)">@L["Sau"]</a> }</nav></footer>
    }
</section>
