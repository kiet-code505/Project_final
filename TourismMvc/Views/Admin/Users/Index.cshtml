@using TourismMvc.Models.Entities
@using TourismMvc.Models.ViewModels
@model AdminUserIndexViewModel
@{
    ViewData["Title"] = L["Quản lý người dùng"];
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var selfId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    string Link(int page) => "/admin/users" + Microsoft.AspNetCore.Http.QueryString.Create(new Dictionary<string, string?>
    {
        ["fullName"] = Model.Filter.FullName, ["email"] = Model.Filter.Email, ["phone"] = Model.Filter.Phone,
        ["status"] = Model.Filter.Status, ["role"] = Model.Filter.Role?.ToString(),
        ["page"] = page.ToString(), ["pageSize"] = Model.Filter.PageSize.ToString()
    }.Where(x => !string.IsNullOrEmpty(x.Value)));
}
<link rel="stylesheet" href="~/css/admin-users.css" asp-append-version="true" />
<header class="page-header">
    <div class="title-block">
        <div class="title-icon"><i data-lucide="users"></i></div>
        <div><h1>@L["Quản lý người dùng"]</h1><p>@L["Tra cứu tài khoản, quản lý trạng thái và xem lịch sử đặt tour"]</p></div>
    </div>
</header>
<section class="stats-grid" aria-label="@L["Thống kê tài khoản"]">
    <div class="stat-card"><div class="stat-icon stat-blue"><i data-lucide="users"></i></div><div><div class="stat-label">@L["Tổng người dùng"]</div><div class="stat-value">@Model.TotalUsers</div></div></div>
    <div class="stat-card"><div class="stat-icon stat-green"><i data-lucide="user-check"></i></div><div><div class="stat-label">@L["Đang hoạt động"]</div><div class="stat-value">@Model.ActiveUsers</div></div></div>
    <div class="stat-card"><div class="stat-icon stat-red"><i data-lucide="user-x"></i></div><div><div class="stat-label">@L["Đã khóa"]</div><div class="stat-value">@Model.LockedUsers</div></div></div>
    <div class="stat-card"><div class="stat-icon stat-amber"><i data-lucide="shield-check"></i></div><div><div class="stat-label">@L["Quản trị viên"]</div><div class="stat-value">@Model.AdminUsers</div></div></div>
</section>
<form method="get" action="/admin/users" class="user-filters">
    <div class="user-filter-fields">
        <div class="form-group"><label for="fullName">@L["Họ tên"]</label><input id="fullName" name="fullName" value="@Model.Filter.FullName" maxlength="100" placeholder="@L["Tìm theo tên…"]" /></div>
        <div class="form-group"><label for="phone">@L["Số điện thoại"]</label><input id="phone" name="phone" value="@Model.Filter.Phone" maxlength="30" inputmode="tel" placeholder="@L["Tìm theo số điện thoại…"]" /></div>
        <div class="form-group"><label for="email">Email</label><input id="email" name="email" value="@Model.Filter.Email" maxlength="254" placeholder="@L["Tìm theo email…"]" /></div>
    </div>
    <div class="user-filter-actions">
        <label for="status" class="sr-only">@L["Trạng thái"]</label>
        <select class="select" id="status" name="status"><option value="">@L["Tất cả trạng thái"]</option><option value="active" selected="@(Model.Filter.Status == "active")">@L["Đang hoạt động"]</option><option value="locked" selected="@(Model.Filter.Status == "locked")">@L["Đã khóa"]</option></select>
        <label for="role" class="sr-only">@L["Vai trò"]</label>
        <select class="select" id="role" name="role"><option value="">@L["Tất cả vai trò"]</option><option value="CUSTOMER" selected="@(Model.Filter.Role == Role.CUSTOMER)">@L["Khách hàng"]</option><option value="ADMIN" selected="@(Model.Filter.Role == Role.ADMIN)">@L["Quản trị viên"]</option><option value="TOUR_OWNER" selected="@(Model.Filter.Role == Role.TOUR_OWNER)">@L["Nhà cung cấp"]</option></select>
        <label for="pageSize" class="sr-only">@L["Số tài khoản mỗi trang"]</label>
        <select class="select" name="pageSize" id="pageSize">@foreach (var size in new[] { 6, 12, 24 }) { <option value="@size" selected="@(Model.Filter.PageSize == size)">@size @L["/ trang"]</option> }</select>
        <button class="btn btn-primary" type="submit"><i data-lucide="search"></i>@L["Tìm kiếm"]</button>
        <a class="btn btn-ghost" href="/admin/users"><i data-lucide="rotate-ccw"></i>@L["Đặt lại"]</a>
    </div>
</form>
<p class="user-result-count" role="status">@L["Tìm thấy"] <strong>@Model.TotalItems</strong> @L["tài khoản"]</p>
@if (Model.Items.Count == 0)
{
    <div class="empty"><div class="empty-icon"><i data-lucide="users"></i></div><h3>@L["Không tìm thấy người dùng phù hợp"]</h3><p>@L["Thử thay đổi tên, email, số điện thoại hoặc bộ lọc."]</p><a href="/admin/users" class="btn btn-ghost">@L["Xóa bộ lọc"]</a></div>
}
else
{
    <div class="user-grid">
        @foreach (var account in Model.Items)
        {
            var isSelf = account.Id.ToString() == selfId;
            <article class="user-card" data-user-id="@account.Id">
                <div class="user-card-heading"><div class="user-avatar"><i data-lucide="user-round"></i></div><div><h2>@account.FullName</h2><p>#@account.Id · @L[account.RoleLabel] @(isSelf ? L["· Bạn"] : "")</p></div></div>
                <div class="user-badges"><span class="badge @(account.Status ? "user-active" : "user-locked")">@(account.Status ? L["Đang hoạt động"] : L["Đã khóa"])</span><span class="user-verification">@(account.IsEmailVerified ? L["Email đã xác thực"] : L["Email chưa xác thực"])</span></div>
                <dl class="user-info"><div><dt><i data-lucide="mail"></i><span class="sr-only">Email</span></dt><dd>@account.Email</dd></div><div><dt><i data-lucide="phone"></i><span class="sr-only">@L["Số điện thoại"]</span></dt><dd>@(string.IsNullOrEmpty(account.Phone) ? L["Chưa cập nhật số điện thoại"] : account.Phone)</dd></div></dl>
                <div class="user-card-footer">
                    <a class="btn btn-ghost" href="@Url.Action("Details", "Users", new { id = account.Id, returnUrl = currentUrl })"><i data-lucide="list-ordered"></i>@account.BookingCount @L["đơn đặt tour"]</a>
                    @if (isSelf)
                    {
                        <span class="user-self" title="@L["Bạn không thể tự khóa tài khoản đang đăng nhập."]"><i data-lucide="shield-check"></i>@L["Tài khoản của bạn"]</span>
                    }
                    else
                    {
                        <a class="btn @(account.Status ? "user-lock-btn" : "user-unlock-btn")" href="@Url.Action("Status", "Users", new { id = account.Id, returnUrl = currentUrl })"><i data-lucide="@(account.Status ? "lock-keyhole" : "unlock-keyhole")"></i>@(account.Status ? L["Khóa"] : L["Mở khóa"])</a>
                    }
                </div>
            </article>
        }
    </div>
    <footer class="table-foot user-pagination">
        <span class="muted">@L["Hiển thị"] @((Model.Filter.Page - 1) * Model.Filter.PageSize + 1)–@Math.Min(Model.Filter.Page * Model.Filter.PageSize, Model.TotalItems) / @Model.TotalItems @L["tài khoản"]</span>
        @if (Model.TotalPages > 1)
        {
            <nav class="pagination" aria-label="@L["Phân trang người dùng"]">
                @if (Model.Filter.Page > 1) { <a class="page-btn" href="@Link(Model.Filter.Page - 1)" rel="prev">@L["Trước"]</a> }
                @for (var p = Math.Max(1, Model.Filter.Page - 2); p <= Math.Min(Model.TotalPages, Model.Filter.Page + 2); p++)
                {
                    <a class="page-num @(p == Model.Filter.Page ? "active" : "")" href="@Link(p)" aria-current="@(p == Model.Filter.Page ? "page" : null)">@p</a>
                }
                @if (Model.Filter.Page < Model.TotalPages) { <a class="page-btn" href="@Link(Model.Filter.Page + 1)" rel="next">@L["Sau"]</a> }
            </nav>
        }
    </footer>
}
