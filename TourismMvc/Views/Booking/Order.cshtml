@model TourismMvc.Models.ViewModels.BookingOrderViewModel
@using TourismMvc.Models.Entities
@{
    Layout = "_UserLayout";
    ViewData["Title"] = L["Đặt tour"]; ViewData["SolidHeader"] = true;
    var info = Model.Info; var departure = info.Departure;
    var vi = L.Culture;
    var today = TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.UtcNow, "SE Asia Standard Time").ToString("yyyy-MM-dd");
    var types = new[] { ("ADULT", L["Người lớn"], L["Từ 12 tuổi"]), ("CHILD", L["Trẻ em"], L["Từ 2 đến 11 tuổi"]), ("INFANT", L["Em bé"], L["Dưới 2 tuổi"]) };
    string Money(decimal amount) => amount.ToString("N0", vi) + " ₫";
    var detailUrl = "/tour/" + Uri.EscapeDataString(info.TourCode) + "?departureId=" + departure.DepartureID;
    var orderUrl = "/order-booking?tourCode=" + Uri.EscapeDataString(info.TourCode) + "&departureId=" + departure.DepartureID;
}
<link rel="stylesheet" href="~/css/booking-components.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />
<div class="tour-booking"><div class="pageContainer"><div class="mainContent">
    <nav class="booking-breadcrumb"><a href="/tours">@L["Chuyến đi"]</a> / <a href="@detailUrl">@info.TourCode</a> @L["/ Đặt tour"]</nav>
    <header class="stepperContainer"><h1 class="pageTitle">@L["ĐẶT TOUR"]</h1><div class="stepper"><div class="step active"><div class="icon">1</div><span>@L["NHẬP THÔNG TIN"]</span></div><div class="line"></div><div class="step"><div class="icon">2</div><span>@L["Thanh toán"]</span></div><div class="line"></div><div class="step"><div class="icon">3</div><span>@L["Xác nhận"]</span></div></div></header>
    @if (!info.CanBook) { <div class="booking-alert" role="status">@L["Lịch này đã hết chỗ, ngừng nhận đặt hoặc chưa có bảng giá."] <a href="@detailUrl">@L["Chọn lịch khởi hành khác"]</a>.</div> }
    @if (!ViewData.ModelState.IsValid) { <div class="booking-alert" role="alert" tabindex="-1" id="booking-errors"><h2>@L["Vui lòng kiểm tra lại thông tin"]</h2><div asp-validation-summary="All"></div></div> }
    <p class="booking-client-error" id="booking-client-error" role="status" hidden></p>
    <form id="booking-order-form" method="post" action="/order-booking" data-slots="@departure.AvailableSlots" data-departure-date="@departure.DepartureDate.ToString("yyyy-MM-dd")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Input.TourCode" value="@Model.Input.TourCode" /><input type="hidden" name="Input.DepartureId" value="@Model.Input.DepartureId" /><input type="hidden" name="Input.SubmissionToken" value="@Model.Input.SubmissionToken" />
        <div class="bookingLayout"><div class="leftColumn">
            <section class="section"><h2 class="sectionHeader">@L["THÔNG TIN LIÊN LẠC"]</h2>
                @if (Model.ContactPrefilled) { <p class="booking-hint">@L["Đã điền từ thông tin của bạn. Bạn có thể chỉnh sửa trước khi gửi."]</p> }
                @if (User.Identity?.IsAuthenticated != true) { <p class="booking-hint">@L["Bạn có thể đặt tour không cần tài khoản hoặc"] <a href="/login?returnUrl=@Uri.EscapeDataString(orderUrl)">@L["đăng nhập để điền nhanh thông tin"]</a>.</p> }
                <div class="formGrid">
                    <div class="formGroup"><label for="contact-name">@L["Họ tên"] <span class="required">*</span></label><input id="contact-name" name="Input.ContactFullName" value="@Model.Input.ContactFullName" autocomplete="name" maxlength="100" required placeholder="@L["Nhập họ tên liên hệ"]" /></div>
                    <div class="formGroup"><label for="contact-phone">@L["Điện thoại"] <span class="required">*</span></label><input id="contact-phone" name="Input.ContactPhone" value="@Model.Input.ContactPhone" autocomplete="tel" type="tel" inputmode="numeric" pattern="[0-9]{10,11}" maxlength="11" required placeholder="@L["Số điện thoại liên hệ"]" /></div>
                    <div class="formGroup"><label for="contact-email">Email <span class="required">*</span></label><input id="contact-email" name="Input.ContactEmail" value="@Model.Input.ContactEmail" autocomplete="email" type="email" maxlength="254" required placeholder="example@email.com" /></div>
                    <div class="formGroup"><label for="contact-address">@L["Địa chỉ"] <span class="required">*</span></label><input id="contact-address" name="Input.ContactAddress" value="@Model.Input.ContactAddress" autocomplete="street-address" maxlength="500" required placeholder="@L["Nhập địa chỉ liên hệ"]" /></div>
                </div>
            </section>
            <section class="section"><h2 class="sectionHeader">@L["HÀNH KHÁCH"]</h2><div class="passengerGrid">
                @foreach (var (type, label, age) in types)
                {
                    var price = info.Prices.FirstOrDefault(p => p.PassengerType.ToString() == type);
                    var count = Model.Input.Passengers.Count(p => p.PassengerType == type);
                    var lastIndex = Model.Input.Passengers.FindLastIndex(p => p.PassengerType == type);
                    <div class="passengerCounter" data-counter="@type" data-label="@label" data-price="@price?.EffectivePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"><div class="info"><strong>@label</strong><small>@age</small><small>@(price != null ? Money(price.EffectivePrice) : L["Chưa có giá"])</small></div><div class="controls"><button type="submit" name="intent" value="remove:@lastIndex" data-remove-type="@type" formnovalidate disabled="@(count == 0 || type == "ADULT" && count <= 1)" aria-label="@L["Giảm số {0}", label]">−</button><span data-count="@type">@count</span><button type="submit" name="intent" value="add:@type" data-add-type="@type" formnovalidate disabled="@(price == null || !info.CanBook)" aria-label="@L["Thêm {0}", label]">+</button></div></div>
                }
            </div><p class="booking-hint">@L["Tuổi được tính vào ngày khởi hành. Mỗi người lớn đi kèm tối đa một em bé. Em bé không tính vào số ghế giữ chỗ."]</p><p class="booking-slots">@L["Còn {0} chỗ · Đang chọn", departure.AvailableSlots] <strong id="selected-seats">@Model.Input.Passengers.Count(p => p.PassengerType != "INFANT")</strong> @L["chỗ"]</p></section>
            <section class="section"><h2 class="sectionHeader">@L["THÔNG TIN HÀNH KHÁCH"]</h2><div id="passenger-list">
            @for (var i = 0; i < Model.Input.Passengers.Count; i++)
            {
                var person = Model.Input.Passengers[i]; var label = types.FirstOrDefault(t => t.Item1 == person.PassengerType).Item2 ?? L["Hành khách"];
                <article class="singlePassengerForm" data-passenger="@person.PassengerType"><header class="booking-passenger-header"><h3 data-passenger-label>@label @(i + 1)</h3><button type="submit" name="intent" value="remove:@i" data-remove-passenger formnovalidate aria-label="@L["Xoá hành khách {0}", i + 1]">@L["Xoá"]</button></header><input type="hidden" name="Input.Passengers[@i].PassengerType" value="@person.PassengerType" />
                    <div class="formRow"><div class="formGroup nameInput"><label for="passenger-name-@i">@L["Họ và tên *"]</label><input id="passenger-name-@i" name="Input.Passengers[@i].FullName" value="@person.FullName" maxlength="100" required autocomplete="off" placeholder="@L["Nhập đúng họ tên hành khách"]" /></div><div class="formGroup smallInput"><label for="passenger-gender-@i">@L["Giới tính *"]</label><select id="passenger-gender-@i" name="Input.Passengers[@i].Gender">@foreach (var gender in new[] { "Nam", "Nữ", "Khác" }) { <option value="@gender" selected="@(person.Gender == gender)">@L[gender]</option> }</select></div><div class="formGroup smallInput"><label for="passenger-birth-@i">@L["Ngày sinh *"]</label><input id="passenger-birth-@i" name="Input.Passengers[@i].DateOfBirth" type="date" value="@person.DateOfBirth?.ToString("yyyy-MM-dd")" max="@today" required /></div></div>
                </article>
            }
            </div></section>
            <section class="section"><h2 class="sectionHeader">@L["GHI CHÚ"]</h2><div class="noteArea"><label class="booking-sr-only" for="customer-note">@L["Ghi chú cho chuyến đi"]</label><textarea id="customer-note" name="Input.CustomerNote" maxlength="2000" rows="4" placeholder="@L["Yêu cầu hoặc thông tin bạn muốn gửi thêm..."]">@Model.Input.CustomerNote</textarea></div></section>
        </div><aside class="rightColumn" aria-label="@L["Tóm tắt đặt tour"]">
            <section class="summaryCard"><div class="tourSummary"><img class="tourImg" src="@(info.ImageUrl ?? "/images/home/ryan-le-8-hEg1OuFn8-unsplash.jpg")" alt="@info.TourName" /><div class="tourText"><h2>@info.TourName</h2><p class="tourCode">@info.TourCode</p></div></div><p class="booking-summary-date"><i data-lucide="calendar-days"></i>@departure.DepartureDate.ToString(L.DateTimeFormat, L.Culture)</p><p class="booking-hint">@info.StartLocation → @info.EndLocation · @info.Duration</p>
                @foreach (var transport in departure.Transports.OrderBy(t => t.Type)) { <div class="booking-transport"><strong>@(transport.Type == TransportType.OUTBOUND ? L["Chiều đi"] : L["Chiều về"]) · @transport.VehicleName</strong><p>@transport.StartPoint → @transport.EndPoint</p><small>@transport.DepartTime?.ToString(L.DateTimeFormat, L.Culture) · @transport.TransportCode</small></div> }
            </section>
            <section class="summaryCard"><h2 class="summaryTitle">@L["TÓM TẮT CHI PHÍ"]</h2><div class="pricingSummary">
                @foreach (var (type, label, age) in types) { <div class="priceRow" data-summary-type="@type"><span>@label <small>@L["×"] <span data-summary-count="@type">@Model.Input.Passengers.Count(p => p.PassengerType == type)</span></small></span><strong data-summary-price="@type">@Money(Model.Input.Passengers.Count(p => p.PassengerType == type) * (info.Prices.FirstOrDefault(p => p.PassengerType.ToString() == type)?.EffectivePrice ?? 0))</strong></div> }
                <div class="divider"></div><div class="finalTotal"><span>@L["Tổng tiền"]</span><strong id="booking-total">@Money(Model.EstimatedTotal)</strong></div>
            </div><p class="booking-hint">@L["Giá được tính theo lịch khởi hành và loại hành khách. Sau khi đặt tour, chỗ được giữ tạm trong thời hạn hiển thị trên trang thanh toán."]</p><label class="booking-agreement"><input type="checkbox" name="Input.AgreeToPolicy" value="true" checked="@Model.Input.AgreeToPolicy" required /><span>@L["Tôi đã đọc và đồng ý với"] <a href="@(detailUrl + "#tour-policies")" target="_blank" rel="noopener">@L["chính sách của chuyến đi"]</a>.</span></label><button class="btnSubmit" type="submit" id="submit-booking" disabled="@(!info.CanBook)">@L["Đặt tour và thanh toán"] <i data-lucide="arrow-right"></i></button><a class="booking-back-link" href="@detailUrl">@L["← Quay lại chi tiết tour"]</a></section>
        </aside></div>
    </form>
</div></div></div>
<template id="passenger-template"><article class="singlePassengerForm" data-passenger=""><header class="booking-passenger-header"><h3 data-passenger-label></h3><button type="button" data-remove-passenger>@L["Xoá"]</button></header><input type="hidden" data-field="PassengerType" /><div class="formRow"><div class="formGroup nameInput"><label>@L["Họ và tên *"]</label><input data-field="FullName" maxlength="100" required autocomplete="off" placeholder="@L["Nhập đúng họ tên hành khách"]" /></div><div class="formGroup smallInput"><label>@L["Giới tính *"]</label><select data-field="Gender"><option value="Nam">@L["Nam"]</option><option value="Nữ">@L["Nữ"]</option><option value="Khác">@L["Khác"]</option></select></div><div class="formGroup smallInput"><label>@L["Ngày sinh *"]</label><input data-field="DateOfBirth" type="date" max="@today" required /></div></div></article></template>
@section Scripts { <script src="~/js/booking.js" asp-append-version="true"></script> }
