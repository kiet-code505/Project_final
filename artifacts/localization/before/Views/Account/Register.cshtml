@model TourismMvc.Models.ViewModels.RegisterViewModel
@{
    Layout = "_UserLayout";
    ViewData["Title"] = "Đăng ký tài khoản";
}
<link rel="stylesheet" href="~/css/auth-components.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
<div class="auth-register"><div class="page"><div class="bgShape1"></div><div class="bgShape2"></div><div class="container">
    <section class="brandSide"><div class="brandInner"><a class="brandLogo" href="/"><div class="brandLogoIcon"><i data-lucide="plane"></i></div><span class="brandName">FUTURE TRAVEL</span></a><h1 class="brandTitle">Tham gia hành trình,<br /><span class="brandTitleAccent">kết nối đam mê du lịch</span></h1><p class="brandSubtitle">Tạo tài khoản miễn phí để bắt đầu hành trình khám phá của bạn.</p><div class="featureList">@foreach (var item in new[] { ("map", "Khám phá Việt Nam", "Tìm điểm đến và hành trình yêu thích"), ("calendar-days", "Lịch khởi hành đa dạng", "Chọn thời gian phù hợp cho chuyến đi"), ("heart", "Đồng hành cùng Future", "Hỗ trợ tư vấn chuyến đi của bạn") }) { <div class="featureItem"><div class="featureIcon"><i data-lucide="@item.Item1"></i></div><div><div class="featureTitle">@item.Item2</div><div class="featureDesc">@item.Item3</div></div></div> }</div><div class="brandFooter"><i data-lucide="shield-check"></i><span>Đồng hành cùng bạn trên mọi chuyến đi</span></div></div></section>
    <section class="formSide"><div class="formCard"><div class="formHeader"><h2 class="formTitle">Đăng ký tài khoản</h2><p class="formSubtitle">Bắt đầu chuyến đi tiếp theo cùng Future Travel.</p></div>
        @if (!ViewData.ModelState.IsValid) { <div class="errorBox" role="alert"><div asp-validation-summary="All"></div></div> }
        <form class="form auth-form" method="post" action="/register">
            @Html.AntiForgeryToken()
            <div class="formGroup"><label class="label" for="FullName">Họ và tên</label><div class="inputWrap"><i data-lucide="user" class="inputIcon"></i><input class="input" id="FullName" name="FullName" value="@Model.FullName" autocomplete="name" required minlength="3" maxlength="100" placeholder="Nguyễn Văn An" /></div></div>
            <div class="formGroup"><label class="label" for="Email">Email</label><div class="inputWrap"><i data-lucide="mail" class="inputIcon"></i><input class="input" id="Email" name="Email" value="@Model.Email" autocomplete="email" type="email" required maxlength="254" placeholder="example@email.com" /></div></div>
            <div class="formGroup"><label class="label" for="Phone">Số điện thoại <span class="auth-optional">(không bắt buộc)</span></label><div class="inputWrap"><i data-lucide="phone" class="inputIcon"></i><input class="input" id="Phone" name="Phone" value="@Model.Phone" autocomplete="tel" type="tel" inputmode="numeric" pattern="[0-9]{10,11}" maxlength="11" placeholder="Số điện thoại liên hệ" /></div></div>
            <div class="formGroup"><label class="label" for="Password">Mật khẩu</label><div class="inputWrap"><i data-lucide="lock" class="inputIcon"></i><input class="input" id="Password" name="Password" type="password" autocomplete="new-password" required minlength="8" maxlength="72" placeholder="Tối thiểu 8 ký tự" /><button class="toggleBtn" type="button" data-toggle-password="Password" aria-label="Hiện mật khẩu" aria-pressed="false"><i data-lucide="eye"></i></button></div><small class="auth-password-hint">Ít nhất 8 ký tự, có chữ hoa, chữ thường và chữ số.</small></div>
            <div class="formGroup"><label class="label" for="ConfirmPassword">Xác nhận mật khẩu</label><div class="inputWrap"><i data-lucide="lock" class="inputIcon"></i><input class="input" id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" required maxlength="72" placeholder="Nhập lại mật khẩu" /><button class="toggleBtn" type="button" data-toggle-password="ConfirmPassword" aria-label="Hiện mật khẩu xác nhận" aria-pressed="false"><i data-lucide="eye"></i></button></div></div>
            <button class="submitBtn" type="submit">Tạo tài khoản <i data-lucide="arrow-right"></i></button>
        </form>
        <p class="formFooter">Đã có tài khoản? <a class="linkAccent" href="/login">Đăng nhập ngay</a></p>
    </div></section>
</div></div></div>

