<!DOCTYPE html><html lang="vi"><head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · Future Travel</title><meta name="description" content="Khám phá chuyến đi, ưu đãi du lịch và điểm đến yêu thích cùng Future Travel." /><link rel="icon" href="/images/home/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet" /><link rel="stylesheet" href="~/css/home-components.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/account-menu.css" asp-append-version="true" /></head><body class="user-home" data-solid-header="@(ViewData["SolidHeader"] is true ? "true" : "false")">
<a class="skip-link" href="#main-content">Đến nội dung chính</a>
<header class="user-header" id="user-header"><a class="user-logo" href="/" aria-label="Future Travel - Trang chủ"><img id="user-logo" src="/images/home/future-logo-light.svg" alt="Future Travel" /></a><button class="menu-toggle" type="button" aria-label="Mở menu" aria-expanded="false" aria-controls="user-navigation"><i data-lucide="menu"></i></button><nav id="user-navigation" aria-label="Điều hướng chính"><a href="/" class="@((Context.Request.Path.StartsWithSegments("/tours") || Context.Request.Path.StartsWithSegments("/tour")) ? "" : "active")">Trang chủ</a><a href="/tours" class="@((Context.Request.Path.StartsWithSegments("/tours") || Context.Request.Path.StartsWithSegments("/tour")) ? "active" : "")">Chuyến đi</a><span aria-disabled="true" title="Sắp ra mắt">✈ Vé máy bay</span><span aria-disabled="true" title="Sắp ra mắt">Vui chơi giải trí</span><span aria-disabled="true" title="Sắp ra mắt">Vé tàu</span></nav><div class="user-header-right"><a class="user-phone" href="tel:19002045"><i data-lucide="phone"></i>1900 2045</a><partial name="_UserAccountMenu" /></div></header>
<main id="main-content">@RenderBody()</main>
<div class="home-footer"><footer class="footer" id="contact"><div class="footerContainer">
    <div class="topSection"><div class="logoColumn"><div class="brandHeader"><div class="brandIcon"><i data-lucide="plane"></i></div><span class="logo">FUTURE TRAVEL</span></div><p class="brandTagline">Đồng hành cùng bạn trên mọi chuyến đi.</p><a class="hotlineBox" href="tel:19001234"><div class="hotlineIcon"><i data-lucide="phone"></i></div><div><div class="hotlineLabel">Hotline 24/7</div><div class="hotlineNumber">1900 1234</div></div></a></div>
    <div class="linkColumns"><div class="linkColumn"><h3 class="columnTitle">Về Future</h3><ul class="menuList"><li><a class="menuLink" href="/#about">Về chúng tôi</a></li><li><a class="menuLink" href="tel:19001234">Liên hệ</a></li><li><a class="menuLink" href="tel:19001234">Trợ giúp</a></li></ul></div><div class="linkColumn"><h3 class="columnTitle">Sản phẩm</h3><ul class="menuList"><li><a class="menuLink" href="/tours">Tour du lịch</a></li><li><a class="menuLink" href="/#special-tours">Chuyến đi ưu đãi</a></li><li><a class="menuLink" href="/#destinations">Điểm đến yêu thích</a></li></ul></div><div class="linkColumn"><h3 class="columnTitle">Khám phá</h3><ul class="menuList"><li><a class="menuLink" href="/#destinations">Du lịch trong nước</a></li><li><a class="menuLink" href="/#about">Tại sao chọn Future?</a></li></ul></div></div></div>
    <div class="middleSection"><div class="paymentBlock"><h3 class="blockTitle"><i data-lucide="credit-card"></i> Đối tác thanh toán</h3><div class="paymentLogos">@foreach (var image in new[] { "VISA", "mastercard", "JCB", "VietcomBank", "TechcomBank", "MBBank", "MoMo", "ZaLoPay", "VNPAY" }) { <div class="paymentCard"><img src="/images/home/@(image).png" alt="@image" loading="lazy" /></div> }</div></div><div class="socialBlock"><h3 class="blockTitle">Kết nối</h3><div class="socialRow"><a class="socialIconBtn" href="https://www.facebook.com/profile.php?id=61590489687138" target="_blank" rel="noopener noreferrer" aria-label="Facebook">f</a><a class="socialIconBtn" href="https://www.youtube.com/@@thoaiuc6257" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><i data-lucide="youtube"></i></a></div></div></div>
    <div class="copyright"><p class="copyrightText">© @DateTime.Now.Year <strong>Future Travel</strong> · Công ty TNHH Future Việt Nam · MST: 0313580179</p></div>
</div></footer></div>
<script src="https://unpkg.com/lucide@0.460.0/dist/umd/lucide.min.js"></script><script src="~/js/home.js" asp-append-version="true"></script><script src="~/js/auth.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body></html>
