@charset "UTF-8";
.auth-login {
  /* ── Login Page — 2-column modern design ─────────────────────── */
}
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-30px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}
@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(30px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}
@keyframes float {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-12px) rotate(2deg);
  }
}
@keyframes blobFloat {
  0%, 100% {
    transform: translate(0, 0) scale(1);
  }
  33% {
    transform: translate(20px, -20px) scale(1.05);
  }
  66% {
    transform: translate(-15px, 10px) scale(0.95);
  }
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
@keyframes shake {
  0%, 100% {
    transform: translateX(0);
  }
  20%, 60% {
    transform: translateX(-6px);
  }
  40%, 80% {
    transform: translateX(6px);
  }
}
@keyframes planeFloat1 {
  0%, 100% {
    transform: translate(0, 0) rotate(-12deg);
  }
  50% {
    transform: translate(10px, -8px) rotate(-8deg);
  }
}
@keyframes planeFloat2 {
  0%, 100% {
    transform: translate(0, 0) rotate(8deg);
  }
  50% {
    transform: translate(-8px, 10px) rotate(12deg);
  }
}
.auth-login {
  /* ── Page wrapper ── */
}
.auth-login .page {
  min-height: 100vh;
  width: 100%;
  background-image: linear-gradient(135deg, rgba(15, 23, 42, 0.55) 0%, rgba(30, 41, 59, 0.45) 100%), url("https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1920&h=1080&fit=crop&q=80");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 16px;
  position: relative;
  overflow: hidden;
  animation: fadeIn 0.4s ease;
  /* Lớp blur cho ảnh nền */
}
.auth-login .page::after {
  content: "";
  position: absolute;
  inset: 0;
  backdrop-filter: blur(4px);
  background: rgba(15, 23, 42, 0.15);
  pointer-events: none;
  z-index: 0;
}
.auth-login {
  /* Subtle pastel blobs để page không quá phẳng */
}
.auth-login .bgShape1, .auth-login .bgShape2, .auth-login .bgShape3 {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  opacity: 0.25;
  pointer-events: none;
  z-index: 0;
  animation: blobFloat 14s ease-in-out infinite;
}
.auth-login .bgShape1 {
  width: 420px;
  height: 420px;
  top: -100px;
  right: -100px;
  background: radial-gradient(circle, #60a5fa, transparent 70%);
}
.auth-login .bgShape2 {
  width: 380px;
  height: 380px;
  bottom: -100px;
  left: -100px;
  background: radial-gradient(circle, #818cf8, transparent 70%);
  animation-delay: -5s;
}
.auth-login .bgShape3 {
  display: none;
}
.auth-login {
  /* ── Container 2-column ── */
}
.auth-login .container {
  margin-top: 60px;
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1100px;
  background: #fff;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 24px;
  overflow: hidden;
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  box-shadow: 0 40px 100px rgba(0, 0, 0, 0.45), 0 15px 40px rgba(0, 0, 0, 0.25);
  animation: fadeIn 0.5s ease;
}
@media (max-width: 900px) {
  .auth-login .container {
    grid-template-columns: 1fr;
    max-width: 460px;
  }
}
.auth-login {
  /* ── Left: Branding side ── */
}
.auth-login .brandSide {
  position: relative;
  padding: 48px 44px;
  background: linear-gradient(135deg, rgba(30, 41, 59, 0.4) 0%, rgba(15, 23, 42, 0.6) 100%), url("https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=900&h=1200&fit=crop&q=80");
  background-size: cover;
  background-position: center;
  color: #fff;
  overflow: hidden;
  animation: slideInLeft 0.6s ease;
}
.auth-login .brandSide::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(30, 41, 59, 0.92) 0%, rgba(15, 23, 42, 0.96) 100%);
  z-index: 0;
}
@media (max-width: 900px) {
  .auth-login .brandSide {
    padding: 32px 28px;
    min-height: 240px;
  }
}
.auth-login .brandInner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
}
.auth-login .brandLogo {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 36px;
}
.auth-login .brandLogoIcon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
  box-shadow: 0 8px 20px rgba(37, 99, 235, 0.45);
}
.auth-login .brandName {
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.5px;
  color: #fff;
}
.auth-login .brandTitle {
  font-size: 28px;
  font-weight: 800;
  line-height: 1.25;
  margin: 0 0 12px 0;
}
@media (max-width: 900px) {
  .auth-login .brandTitle {
    font-size: 22px;
  }
}
.auth-login .brandTitleAccent {
  background: linear-gradient(135deg, #60a5fa, #93c5fd);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.auth-login .brandSubtitle {
  font-size: 13.5px;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.78);
  margin: 0 0 28px 0;
  max-width: 360px;
}
.auth-login .featureList {
  display: flex;
  flex-direction: column;
  gap: 14px;
  flex: 1;
}
@media (max-width: 900px) {
  .auth-login .featureList {
    display: none;
  }
}
.auth-login .featureItem {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 10px 12px;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  transition: all 0.25s ease;
}
.auth-login .featureItem:hover {
  background: rgba(255, 255, 255, 0.13);
  transform: translateX(4px);
}
.auth-login .featureIcon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 9px;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
}
.auth-login .featureTitle {
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 2px;
}
.auth-login .featureDesc {
  font-size: 11.5px;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.4;
}
.auth-login .brandFooter {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 24px;
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  font-size: 11px;
  color: rgba(255, 255, 255, 0.6);
}
@media (max-width: 900px) {
  .auth-login .brandFooter {
    display: none;
  }
}
.auth-login {
  /* Floating decorative plane icons */
}
.auth-login .mosaicPlane1, .auth-login .mosaicPlane2 {
  position: absolute;
  width: 80px;
  height: 80px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.15);
  z-index: 0;
  pointer-events: none;
}
.auth-login .mosaicPlane1 {
  top: 20%;
  right: -20px;
  animation: planeFloat1 6s ease-in-out infinite;
}
.auth-login .mosaicPlane2 {
  bottom: 15%;
  right: 24px;
  width: 60px;
  height: 60px;
  animation: planeFloat2 7s ease-in-out infinite;
}
.auth-login {
  /* ── Right: Form side ── */
}
.auth-login .formSide {
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48px 44px;
  animation: slideInRight 0.6s ease;
}
@media (max-width: 900px) {
  .auth-login .formSide {
    padding: 32px 24px;
  }
}
.auth-login .formCard {
  width: 100%;
  max-width: 360px;
}
.auth-login .formHeader {
  margin-bottom: 24px;
}
.auth-login .formTitle {
  font-size: 26px;
  font-weight: 800;
  color: #0f172a;
  margin: 0 0 6px 0;
  letter-spacing: -0.5px;
}
.auth-login .formSubtitle {
  font-size: 13px;
  color: #64748b;
  margin: 0;
  line-height: 1.5;
}
.auth-login {
  /* Error box */
}
.auth-login .errorBox {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 11px 14px;
  background: linear-gradient(135deg, #fef2f2, #fee2e2);
  border: 1px solid #fecaca;
  border-left: 3px solid #dc2626;
  border-radius: 10px;
  color: #b91c1c;
  font-size: 12.5px;
  font-weight: 500;
  margin-bottom: 16px;
  animation: shake 0.4s ease;
}
.auth-login .successBox {
  padding: 11px 14px;
  margin-bottom: 16px;
  border: 1px solid #a7f3d0;
  border-left: 3px solid #059669;
  border-radius: 10px;
  background: #ecfdf5;
  color: #047857;
  font-size: 12.5px;
  font-weight: 600;
}
.auth-login {
  /* Google button */
}
.auth-login .googleBtn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 11px 16px;
  background: #fff;
  border: 1.5px solid #e2e8f0;
  border-radius: 11px;
  font-size: 13.5px;
  font-weight: 600;
  color: #334155;
  cursor: pointer;
  transition: all 0.2s ease;
  margin-bottom: 18px;
}
.auth-login .googleBtn:hover:not(:disabled) {
  border-color: #2563eb;
  background: #eff6ff;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);
}
.auth-login .googleBtn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
.auth-login {
  /* Divider */
}
.auth-login .divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
  color: #94a3b8;
  font-size: 11px;
  font-weight: 500;
}
.auth-login .divider::before, .auth-login .divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background: #e2e8f0;
}
.auth-login {
  /* Form */
}
.auth-login .form {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.auth-login .formGroup {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.auth-login .labelRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.auth-login .label {
  font-size: 12.5px;
  font-weight: 600;
  color: #334155;
}
.auth-login .forgotLink {
  font-size: 11.5px;
  color: #2563eb;
  text-decoration: none;
  font-weight: 600;
  transition: color 0.2s ease;
}
.auth-login .forgotLink:hover {
  color: #1d4ed8;
  text-decoration: underline;
}
.auth-login .inputWrap {
  position: relative;
  display: flex;
  align-items: center;
  background: #f8fafc;
  border: 1.5px solid #e2e8f0;
  border-radius: 11px;
  transition: all 0.2s ease;
}
.auth-login .inputWrap:focus-within {
  border-color: #2563eb;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}
.auth-login .inputErr {
  border-color: #fca5a5 !important;
  background: #fef2f2 !important;
}
.auth-login .inputErr:focus-within {
  border-color: #dc2626 !important;
  box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.12) !important;
}
.auth-login .inputIcon {
  position: absolute;
  left: 12px;
  color: #94a3b8;
  pointer-events: none;
}
.auth-login .input {
  width: 100%;
  padding: 11px 14px 11px 38px;
  background: transparent;
  border: none;
  outline: none;
  font-size: 13.5px;
  color: #0f172a;
  font-family: inherit;
}
.auth-login .input::placeholder {
  color: #cbd5e1;
}
.auth-login .input:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
.auth-login .toggleBtn {
  position: absolute;
  right: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  background: transparent;
  border: none;
  border-radius: 7px;
  color: #94a3b8;
  cursor: pointer;
  transition: all 0.2s ease;
}
.auth-login .toggleBtn:hover {
  background: #e2e8f0;
  color: #2563eb;
}
.auth-login .toggleBtn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
.auth-login .errText {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 11.5px;
  color: #dc2626;
  font-weight: 500;
  margin-top: 2px;
}
.auth-login {
  /* Submit button */
}
.auth-login .submitBtn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  width: 100%;
  padding: 12px 16px;
  margin-top: 4px;
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  border: none;
  border-radius: 11px;
  color: #fff;
  font-size: 13.5px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 6px 18px rgba(37, 99, 235, 0.45);
}
.auth-login .submitBtn:hover:not(:disabled) {
  background: linear-gradient(135deg, #2563eb, #1e40af);
  transform: translateY(-2px);
  box-shadow: 0 10px 24px rgba(37, 99, 235, 0.55);
}
.auth-login .submitBtn:active:not(:disabled) {
  transform: translateY(0);
}
.auth-login .submitBtn:disabled {
  opacity: 0.7;
  cursor: not-allowed;
  transform: none;
}
.auth-login .spinner {
  width: 14px;
  height: 14px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}
.auth-login .formFooter {
  text-align: center;
  font-size: 12.5px;
  color: #64748b;
  margin: 22px 0 0 0;
}
.auth-login .linkAccent {
  color: #2563eb;
  font-weight: 700;
  text-decoration: none;
  transition: color 0.2s ease;
}
.auth-login .linkAccent:hover {
  color: #1d4ed8;
  text-decoration: underline;
}

