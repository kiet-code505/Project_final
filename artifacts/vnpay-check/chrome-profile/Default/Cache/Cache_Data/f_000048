  background: #f8fafc;
  border: 1.5px solid #e2e8f0;
  border-radius: 11px;
  transition: all 0.2s ease;
}
.auth-admin .inputWrap:focus-within {
  border-color: #dc2626;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.12);
}
.auth-admin .inputErr {
  border-color: #fca5a5 !important;
  background: #fef2f2 !important;
}
.auth-admin .inputErr:focus-within {
  border-color: #dc2626 !important;
  box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.15) !important;
}
.auth-admin .inputIcon {
  position: absolute;
  left: 12px;
  color: #94a3b8;
  pointer-events: none;
}
.auth-admin .input {
  width: 100%;
  padding: 11px 14px 11px 38px;
  background: transparent;
  border: none;
  outline: none;
  font-size: 13.5px;
  color: #0f172a;
  font-family: inherit;
}
.auth-admin .input::placeholder {
  color: #cbd5e1;
}
.auth-admin .input:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
.auth-admin .toggleBtn {
  position: absolute;
  right: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  background: transparent;
  border: none;
  border-radius: 7px;
  color: #94a3b8;
  cursor: pointer;
  transition: all 0.2s ease;
}
.auth-admin .toggleBtn:hover {
  background: #e2e8f0;
  color: #dc2626;
}
.auth-admin .toggleBtn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
.auth-admin .errText {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 11.5px;
  color: #dc2626;
  font-weight: 500;
  margin-top: 2px;
}
.auth-admin {
  /* Submit */
}
.auth-admin .submitBtn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  width: 100%;
  padding: 12px 16px;
  margin-top: 8px;
  background: linear-gradient(135deg, #0f172a, #1e293b);
  border: none;
  border-radius: 11px;
  color: #fff;
  font-size: 13.5px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 6px 18px rgba(15, 23, 42, 0.4);
}
.auth-admin .submitBtn:hover:not(:disabled) {
  background: linear-gradient(135deg, #1e293b, #334155);
  transform: translateY(-2px);
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.5);
}
.auth-admin .submitBtn:active:not(:disabled) {
  transform: translateY(0);
}
.auth-admin .submitBtn:disabled {
  opacity: 0.7;
  cursor: not-allowed;
  transform: none;
}
.auth-admin .spinner {
  width: 14px;
  height: 14px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}
.auth-admin {
  /* Warning note */
}
.auth-admin .warningNote {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-top: 20px;
  padding: 12px 14px;
  background: linear-gradient(135deg, #fef2f2, #fee2e2);
  border: 1px solid #fecaca;
  border-radius: 11px;
  font-size: 12px;
  color: #7f1d1d;
  line-height: 1.5;
}
.auth-admin .warningNote svg {
  flex-shrink: 0;
  color: #dc2626;
  margin-top: 1px;
}
.auth-admin .warningNote strong {
  color: #991b1b;
}
