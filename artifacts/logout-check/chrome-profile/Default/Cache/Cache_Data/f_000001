      transform: rotate(0deg) translateX(160px) rotate(0deg);
    }
    100% {
      transform: rotate(360deg) translateX(160px) rotate(-360deg);
    }
  }
  .home-trust .content {
    flex-direction: column;
    gap: 50px;
    text-align: center;
  }
  .home-trust .textColumn {
    max-width: 100%;
    padding-right: 0;
  }
  .home-trust .imageColumn {
    max-width: 100%;
    height: 400px;
    overflow: visible;
  }
  .home-trust .mainImage {
    width: 100%;
    height: 100%;
  }
  .home-trust .decorativeElements {
    width: 160%;
    height: 160%;
  }
  .home-trust .statsRow {
    justify-content: center;
  }
  .home-trust .decorativeIcon {
    width: 30px;
    height: 30px;
    margin-left: -15px;
    margin-top: -15px;
  }
  .home-trust .icon1 {
    transform: rotate(0deg) translateX(160px) rotate(0deg);
  }
  .home-trust .icon2 {
    transform: rotate(72deg) translateX(160px) rotate(-72deg);
  }
  .home-trust .icon3 {
    transform: rotate(144deg) translateX(160px) rotate(-144deg);
  }
  .home-trust .icon4 {
    transform: rotate(216deg) translateX(160px) rotate(-216deg);
  }
  .home-trust .icon5 {
    transform: rotate(288deg) translateX(160px) rotate(-288deg);
  }
}

.home-footer {
  /* ── Footer — Light, bold, compact ─────────────────────────── */
}
.home-footer .footer {
  background: linear-gradient(180deg, #f8fafc 0%, #eff6ff 100%);
  color: #1e293b;
  padding: 56px 0 24px;
  font-size: 14.5px;
  position: relative;
  overflow: hidden;
  border-top: 1px solid #e2e8f0;
}
.home-footer .footer::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, #3b82f6, #6366f1, #ec4899, #f59e0b);
}
.home-footer .footerContainer {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 24px;
}
.home-footer {
  /* ── Top section: Brand + Menu ── */
}
.home-footer .topSection {
  display: grid;
  grid-template-columns: 1.2fr 2.5fr;
  gap: 56px;
  padding-bottom: 36px;
  border-bottom: 1px solid #e2e8f0;
}
@media (max-width: 980px) {
  .home-footer .topSection {
    grid-template-columns: 1fr;
    gap: 32px;
  }
}
.home-footer .logoColumn {
  display: flex;
  flex-direction: column;
}
.home-footer .brandHeader {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}
.home-footer .brandIcon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
  box-shadow: 0 8px 20px rgba(37, 99, 235, 0.35);
}
.home-footer .logo {
  font-size: 22px;
  font-weight: 900;
  letter-spacing: 0.5px;
  background: linear-gradient(135deg, #1e3a8a, #2563eb);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.home-footer .brandTagline {
  font-size: 15px;
  font-weight: 500;
  color: #475569;
  line-height: 1.6;
  margin: 0 0 20px 0;
  max-width: 320px;
}
.home-footer {
  /* Hotline box nổi bật */
}
.home-footer .hotlineBox {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 12px 18px;
  background: #fff;
  border: 1.5px solid #dbeafe;
  border-radius: 14px;
  box-shadow: 0 4px 16px rgba(37, 99, 235, 0.08);
  align-self: flex-start;
}
.home-footer .hotlineIcon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
  flex-shrink: 0;
}
.home-footer .hotlineLabel {
  font-size: 11px;
  font-weight: 700;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.home-footer .hotlineNumber {
  font-size: 19px;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: -0.3px;
  margin-top: 2px;
}
.home-footer {
  /* ── Link columns (3 cột) ── */
}
.home-footer .linkColumns {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}
@media (max-width: 760px) {
  .home-footer .linkColumns {
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }
}
.home-footer .linkColumn {
  min-width: 0;
}
.home-footer .columnTitle {
  font-size: 15.5px;
  font-weight: 800;
  color: #0f172a;
  margin: 0 0 16px 0;
  letter-spacing: 0.2px;
  position: relative;
  padding-bottom: 10px;
}
.home-footer .columnTitle::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 32px;
  height: 3px;
  background: linear-gradient(90deg, #3b82f6, #6366f1);
  border-radius: 2px;
}
.home-footer .menuList {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.home-footer .menuLink {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #475569;
  text-decoration: none;
  padding: 5px 0;
  font-size: 14px;
  font-weight: 600;
  transition: all 0.2s ease;
}
.home-footer .menuLink:hover {
  color: #2563eb;
  transform: translateX(4px);
}
.home-footer .menuIcon {
  font-size: 16px;
  color: #94a3b8;
  flex-shrink: 0;
}
.home-footer {
  /* ── Middle section: Payment + Social trên 1 hàng ── */
}
.home-footer .middleSection {
  display: grid;
  grid-template-columns: 2.5fr 1fr;
  gap: 32px;
  align-items: start;
  padding: 28px 0;
  border-bottom: 1px solid #e2e8f0;
}
@media (max-width: 900px) {
  .home-footer .middleSection {
    grid-template-columns: 1fr;
    gap: 24px;
  }
}
.home-footer .blockTitle {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15.5px;
  font-weight: 800;
  color: #0f172a;
  margin: 0 0 14px 0;
  letter-spacing: 0.2px;
}
.home-footer .blockTitle svg {
  color: #2563eb;
}
.home-footer .paymentBlock {
  min-width: 0;
}
.home-footer .paymentLogos {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.home-footer .paymentCard {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84px;
  height: 48px;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  padding: 8px 12px;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 2px 6px rgba(15, 23, 42, 0.05);
}
.home-footer .paymentCard img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  transition: transform 0.25s ease;
}
.home-footer .paymentCard:hover {
  transform: translateY(-3px) scale(1.05);
  box-shadow: 0 10px 24px rgba(59, 130, 246, 0.25);
  border-color: #3b82f6;
}
.home-footer .paymentCard:hover img {
  transform: scale(1.08);
}
.home-footer {
  /* ── Social ── */
}
.home-footer .socialBlock {
  min-width: 0;
}
.home-footer .socialRow {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.home-footer .socialIconBtn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #fff;
  border: 1.5px solid #e2e8f0;
  color: #64748b;
  text-decoration: none;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 2px 6px rgba(15, 23, 42, 0.05);
}
.home-footer .socialIconBtn:hover {
  background: var(--social-color, #2563eb);
  color: #fff;
  transform: translateY(-3px);
  border-color: var(--social-color, #2563eb);
  box-shadow: 0 8px 20px rgba(15, 23, 42, 0.2);
}
.home-footer .socialIcon {
  font-size: 18px;
}
.home-footer {
  /* ── Copyright ── */
}
.home-footer .copyright {
  text-align: center;
  padding-top: 20px;
}
.home-footer .copyrightText {
  font-size: 13.5px;
  font-weight: 600;
  color: #475569;
  margin: 0;
  letter-spacing: 0.1px;
}
.home-footer .copyrightText strong {
  color: #0f172a;
  font-weight: 800;
}
