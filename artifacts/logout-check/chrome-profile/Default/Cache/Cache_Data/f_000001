  animation: heroSlideUp 0.62s cubic-bezier(0.22, 1, 0.36, 1) 0.26s both;
  border-radius: 8px;
  box-shadow: 0 20px 48px rgba(6, 17, 33, 0.22);
  backdrop-filter: blur(2px);
  animation: heroReveal 0.72s ease 0.08s both;
  transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
}
