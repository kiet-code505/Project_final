.home-banner .bannerContainer {
  position: relative;
  width: 100%;
  min-height: 670px;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  overflow: visible;
  isolation: isolate;
}
.home-banner .bgClip {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: -1;
}
.home-banner .bgLayer {
  position: absolute;
  inset: -10%;
  background-image: url("/images/home/ryan-le-8-hEg1OuFn8-unsplash.jpg");
  background-size: cover;
  background-position: center 48%;
  animation: heroBgMove 24s ease-in-out infinite alternate;
  will-change: transform;
}
@keyframes heroBgMove {
  0% {
    transform: scale(1) translate(0, 0);
  }
  25% {
    transform: scale(1.06) translate(-1.5%, -1%);
  }
  50% {
    transform: scale(1.04) translate(1.5%, 1.5%);
  }
  75% {
    transform: scale(1.08) translate(-0.5%, 2%);
  }
  100% {
    transform: scale(1.05) translate(1%, -0.5%);
  }
}
.home-banner .overlay {
  position: absolute;
  inset: 0;
  z-index: 0;
  background: linear-gradient(180deg, rgba(4, 22, 38, 0.28) 0%, rgba(4, 22, 38, 0.18) 30%, rgba(4, 22, 38, 0.52) 100%), linear-gradient(90deg, rgba(4, 22, 38, 0.48) 0%, rgba(4, 22, 38, 0.18) 50%, rgba(4, 22, 38, 0.32) 100%);
  pointer-events: none;
  backdrop-filter: blur(0.7px);
}
.home-banner .content {
  position: relative;
  z-index: 30;
  width: min(90%, 1280px);
  margin: 0 auto;
  display: grid;
  grid-template-areas: "copy info" "search info" "error info";
  grid-template-columns: minmax(0, 1.85fr) minmax(320px, 0.78fr);
  column-gap: clamp(42px, 7vw, 112px);
  row-gap: 22px;
  padding-top: 138px;
}
.home-banner .heroCopy {
  grid-area: copy;
  max-width: 830px;
}
.home-banner .headline {
  margin: 0;
  color: #ffffff;
  font-size: clamp(2.1rem, 3.7vw, 3.45rem);
  line-height: 1.08;
  font-weight: 820;
  letter-spacing: 0;
  text-shadow: 0 12px 34px rgba(0, 0, 0, 0.32);
  animation: heroSlideUp 0.62s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.home-banner .subHeadline {
